<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin - <%= title || 'PuraPaw' %></title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--green:#7B4B94;--forest:#4A2C5A;--mint:#F0E6F5;--cream:#FFFFFF;--ink:#3D2E4F;--body:#5A4A6B;--line:#E8E0EE;--shadow:0 18px 40px -18px rgba(74,44,90,.25)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',system-ui,sans-serif;background:#F5F2F8;color:var(--body);line-height:1.6}
a{text-decoration:none;color:inherit}
.admin{display:grid;grid-template-columns:248px 1fr;min-height:100vh}
.sidebar{background:var(--forest);color:rgba(255,255,255,.78);padding:24px 0;position:sticky;top:0;height:100vh;overflow-y:auto}
.side-logo{display:flex;align-items:center;gap:10px;font-family:'Poppins';font-weight:800;font-size:20px;color:#fff;padding:0 24px;margin-bottom:28px}
.side-logo .mark{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--green),#C4A6D5);display:grid;place-items:center;color:#fff;font-size:18px}
.nav-group{padding:0 16px}
.nav-item{display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:10px;font-size:14.5px;font-weight:500;color:rgba(255,255,255,.72);transition:.2s;margin-bottom:3px}
.nav-item:hover{background:rgba(255,255,255,.08);color:#fff}
.nav-item.active{background:var(--green);color:#fff}
.nav-item i{width:18px;text-align:center}
.side-foot{margin-top:auto;padding:16px 24px;font-size:12px;color:rgba(255,255,255,.4)}
.main{padding:32px 40px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
.topbar h1{font-family:'Poppins';font-size:26px;color:var(--ink)}
.topbar .acts{display:flex;gap:10px}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:'Poppins';font-weight:600;font-size:14px;padding:10px 18px;border-radius:9px;cursor:pointer;border:none;transition:.2s}
.btn-primary{background:var(--green);color:#fff}
.btn-primary:hover{background:var(--forest)}
.btn-ghost{background:#fff;color:var(--green);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--green)}
.btn-sm{padding:7px 12px;font-size:13px;border-radius:7px}
.btn-danger{background:#fff;color:#c0392b;border:1.5px solid #f5c6cb}
.btn-danger:hover{background:#c0392b;color:#fff}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px;margin-bottom:34px}
.stat{background:#fff;border-radius:14px;padding:24px;box-shadow:var(--shadow);border:1px solid var(--line)}
.stat .ico{width:46px;height:46px;border-radius:11px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-size:20px;margin-bottom:14px}
.stat .n{font-family:'Poppins';font-weight:800;font-size:28px;color:var(--ink)}
.stat .l{font-size:13px;color:#888}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}
.link-card{background:#fff;border-radius:14px;padding:22px;box-shadow:var(--shadow);border:1px solid var(--line);transition:.25s}
.link-card:hover{transform:translateY(-4px);border-color:var(--green)}
.link-card .ico{width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--green),#9B6BB0);color:#fff;display:grid;place-items:center;font-size:20px;margin-bottom:14px}
.link-card h3{font-family:'Poppins';font-size:17px;color:var(--ink);margin-bottom:4px}
.link-card p{font-size:13px;color:#888}
.flash{background:#F0E6F5;color:#4A2C5A;padding:12px 18px;border-radius:10px;margin-bottom:20px;font-weight:600;font-size:14px}
table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;box-shadow:var(--shadow)}
th{background:var(--cream);text-align:left;padding:14px 16px;font-family:'Poppins';font-weight:600;font-size:13.5px;color:var(--ink)}
td{padding:13px 16px;border-top:1px solid var(--line);font-size:14px;vertical-align:top}
tr:hover td{background:#F8F6FA}
.muted{color:#999}
.badge-on{background:var(--mint);color:var(--green);padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600}
.badge-off{background:#fdeaea;color:#c0392b;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600}
.form-card{background:#fff;border-radius:14px;padding:28px;box-shadow:var(--shadow);border:1px solid var(--line);margin-top:20px}
.form-card h3{font-family:'Poppins';font-size:18px;margin-bottom:20px;color:var(--ink)}
.field{margin-bottom:16px}
.field label{display:block;font-family:'Poppins';font-weight:500;font-size:13.5px;margin-bottom:6px;color:var(--ink)}
.field input,.field textarea,.field select{width:100%;padding:11px 14px;border:1.5px solid var(--line);border-radius:9px;font-family:'Inter';font-size:14px;color:var(--ink)}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(123,75,148,.1)}
.field textarea{resize:vertical;min-height:90px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.toggle{display:inline-flex;align-items:center;gap:8px}
.toggle input{width:auto}
@media(max-width:860px){.admin{grid-template-columns:1fr}.sidebar{position:fixed;left:-260px;z-index:50;transition:.3s}.sidebar.open{left:0}.main{padding:20px}.menu-btn{display:inline-flex!important}}
.menu-btn{display:none;background:#fff;border:1.5px solid var(--line);border-radius:9px;padding:9px 13px;font-size:16px;cursor:pointer;color:var(--forest)}
</style>
</head>
<body>
<div class="admin">
<aside class="sidebar" id="sidebar">
<div class="side-logo"><span class="mark"><i class="fa-solid fa-paw"></i></span>PuraPaw</div>
<div class="nav-group">
<a class="nav-item <%= active==='dashboard'?'active':'' %>" href="/admin"><i class="fa-solid fa-gauge"></i> Dashboard</a>
<a class="nav-item <%= active==='settings'?'active':'' %>" href="/admin/settings"><i class="fa-solid fa-gear"></i> Site Settings</a>
<% Object.keys(resources).forEach(function(key){ var c=resources[key]; %>
<a class="nav-item <%= active===key?'active':'' %>" href="/admin/<%= key %>"><i class="fa-solid fa-table"></i> <%= c.label %></a>
<% }) %>
</div>
<div class="side-foot">Logged in as <b><%= user %></b><br><br><form action="/admin/logout" method="POST" style="display:inline"><button class="nav-item" style="background:rgba(255,255,255,.08);border:none;color:#fff;width:100%"><i class="fa-solid fa-right-from-bracket"></i> Logout</button></form></div>
</aside>
<div class="main">
<div class="topbar">
<div style="display:flex;align-items:center;gap:12px">
<button class="menu-btn" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="fa-solid fa-bars"></i></button>
<h1><%= title || 'Dashboard' %></h1>
</div>
<div class="acts">
<a href="/" target="_blank" class="btn btn-ghost btn-sm"><i class="fa-solid fa-up-right-from-square"></i> View Site</a>
</div>
</div>
