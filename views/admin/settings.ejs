<%- include('_layout', {title:'Site Settings', active:'settings', resources:resources, user:user}) %>
<p style="color:#888;margin-bottom:8px">Edit the global content shown across the homepage.</p>
<% if (flash) { %><div class="flash"><i class="fa-solid fa-circle-check"></i> <%= flash %></div><% } %>

<form action="/admin/settings" method="POST" class="form-card">
<h3><i class="fa-solid fa-identity-card"></i> Brand</h3>
<div class="row2">
<div class="field"><label>Brand Name</label><input type="text" name="brandName" value="<%= d.settings.brandName %>"></div>
<div class="field"><label>Brand Tagline</label><input type="text" name="brandTagline" value="<%= d.settings.brandTagline %>"></div>
</div>
<div class="field"><label>Footer About</label><textarea name="footerAbout"><%= d.settings.footerAbout %></textarea></div>
<div class="row2">
<div class="field"><label>Copyright Year</label><input type="text" name="copyrightYear" value="<%= d.settings.copyrightYear %>"></div>
<div class="field"><label>Footer "Back to top" text</label><input type="text" name="footerBackTop" value="<%= d.settings.footerBackTop %>"></div>
</div>

<h3 style="margin-top:26px"><i class="fa-solid fa-bullhorn"></i> Hero Section</h3>
<div class="row2">
<div class="field"><label>Hero Eyebrow</label><input type="text" name="heroEyebrow" value="<%= d.settings.heroEyebrow %>"></div>
<div class="field"><label>Hero Image URL</label><input type="text" name="heroImg" value="<%= d.settings.heroImg %>"></div>
</div>
<div class="field"><label>Hero Title</label><input type="text" name="heroTitle" value="<%= d.settings.heroTitle %>"></div>
<div class="field"><label>Hero Lead Text</label><textarea name="heroLead"><%= d.settings.heroLead %></textarea></div>
<div class="field"><label>Marquee Items (use - as separator)</label><input type="text" name="marquee" value="<%= Array.isArray(d.settings.marquee)?d.settings.marquee.join(' - '):d.settings.marquee %>"></div>
<div class="row2">
<div class="field"><label>Hero Explore Button</label><input type="text" name="heroExploreBtn" value="<%= d.settings.heroExploreBtn %>"></div>
<div class="field"><label>Hero OEM Button</label><input type="text" name="heroOemBtn" value="<%= d.settings.heroOemBtn %>"></div>
</div>
<div class="row2">
<div class="field"><label>Hero Plant-Based Tag</label><input type="text" name="heroPlantBasedTag" value="<%= d.settings.heroPlantBasedTag %>"></div>
<div class="field"><label>Hero Badge Title</label><input type="text" name="heroBadgeTitle" value="<%= d.settings.heroBadgeTitle %>"></div>
</div>
<div class="field"><label>Hero Badge Subtitle</label><input type="text" name="heroBadgeSub" value="<%= d.settings.heroBadgeSub %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-chart-simple"></i> Hero Stats</h3>
<div class="row2">
<div class="field"><label>Stat 1 Number</label><input type="number" name="stat1Num" value="<%= d.settings.stat1Num %>"></div>
<div class="field"><label>Stat 1 Label</label><input type="text" name="stat1Lbl" value="<%= d.settings.stat1Lbl %>"></div>
</div>
<div class="row2">
<div class="field"><label>Stat 2 Number</label><input type="number" name="stat2Num" value="<%= d.settings.stat2Num %>"></div>
<div class="field"><label>Stat 2 Label</label><input type="text" name="stat2Lbl" value="<%= d.settings.stat2Lbl %>"></div>
</div>
<div class="row2">
<div class="field"><label>Stat 3 Number</label><input type="number" name="stat3Num" value="<%= d.settings.stat3Num %>"></div>
<div class="field"><label>Stat 3 Label</label><input type="text" name="stat3Lbl" value="<%= d.settings.stat3Lbl %>"></div>
</div>
<div class="row2">
<div class="field"><label>Stat 4 Number</label><input type="number" name="stat4Num" value="<%= d.settings.stat4Num %>"></div>
<div class="field"><label>Stat 4 Label</label><input type="text" name="stat4Lbl" value="<%= d.settings.stat4Lbl %>"></div>
</div>

<h3 style="margin-top:26px"><i class="fa-solid fa-box"></i> Products Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="productsEyebrow" value="<%= d.settings.productsEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="productsTitle" value="<%= d.settings.productsTitle %>"></div>
<div class="field"><label>Subtitle</label><textarea name="productsSubtitle"><%= d.settings.productsSubtitle %></textarea></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-heart-pulse"></i> Health Litter Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="healthEyebrow" value="<%= d.settings.healthEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="healthTitle" value="<%= d.settings.healthTitle %>"></div>
<div class="field"><label>Subtitle</label><textarea name="healthSubtitle"><%= d.settings.healthSubtitle %></textarea></div>
<div class="field"><label>Ring Badge Text (supports HTML)</label><input type="text" name="healthRingText" value="<%= d.settings.healthRingText %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-leaf"></i> About Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="aboutEyebrow" value="<%= d.settings.aboutEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="aboutTitle" value="<%= d.settings.aboutTitle %>"></div>
<div class="field"><label>Text</label><textarea name="aboutText"><%= d.settings.aboutText %></textarea></div>
<div class="row2">
<div class="field"><label>About Stat Number</label><input type="number" name="aboutStat" value="<%= d.settings.aboutStat %>"></div>
<div class="field"><label>About Stat Label</label><input type="text" name="aboutStatLbl" value="<%= d.settings.aboutStatLbl %>"></div>
</div>
<div class="row2">
<div class="field"><label>About Main Image URL</label><input type="text" name="aboutMainImg" value="<%= d.settings.aboutMainImg %>"></div>
<div class="field"><label>About Sub Image URL</label><input type="text" name="aboutSubImg" value="<%= d.settings.aboutSubImg %>"></div>
</div>

<h3 style="margin-top:26px"><i class="fa-solid fa-gears"></i> OEM Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="oemEyebrow" value="<%= d.settings.oemEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="oemTitle" value="<%= d.settings.oemTitle %>"></div>
<div class="field"><label>Subtitle</label><textarea name="oemSubtitle"><%= d.settings.oemSubtitle %></textarea></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-route"></i> Process Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="processEyebrow" value="<%= d.settings.processEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="processTitle" value="<%= d.settings.processTitle %>"></div>
<div class="field"><label>Subtitle</label><input type="text" name="processSubtitle" value="<%= d.settings.processSubtitle %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-star"></i> Featured / Highlights Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="featureEyebrow" value="<%= d.settings.featureEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="featureTitle" value="<%= d.settings.featureTitle %>"></div>
<div class="field"><label>Subtitle</label><input type="text" name="featureSubtitle" value="<%= d.settings.featureSubtitle %>"></div>
<div class="row2">
<div class="field"><label>Featured Product Label</label><input type="text" name="featureLabel" value="<%= d.settings.featureLabel %>"></div>
<div class="field"><label>Featured Tag</label><input type="text" name="featureTag" value="<%= d.settings.featureTag %>"></div>
</div>
<div class="field"><label>Featured Image URL</label><input type="text" name="featureImg" value="<%= d.settings.featureImg %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-quote-left"></i> Testimonials Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="testiEyebrow" value="<%= d.settings.testiEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="testiTitle" value="<%= d.settings.testiTitle %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-newspaper"></i> Blog Section Header</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="blogEyebrow" value="<%= d.settings.blogEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="blogTitle" value="<%= d.settings.blogTitle %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-bullhorn"></i> CTA Banner</h3>
<div class="field"><label>Title</label><input type="text" name="ctaTitle" value="<%= d.settings.ctaTitle %>"></div>
<div class="field"><label>Subtitle</label><textarea name="ctaSubtitle"><%= d.settings.ctaSubtitle %></textarea></div>
<div class="row2">
<div class="field"><label>Primary Button</label><input type="text" name="ctaPrimaryBtn" value="<%= d.settings.ctaPrimaryBtn %>"></div>
<div class="field"><label>Secondary Button</label><input type="text" name="ctaSecondaryBtn" value="<%= d.settings.ctaSecondaryBtn %>"></div>
</div>

<h3 style="margin-top:26px"><i class="fa-solid fa-envelope"></i> Contact Section</h3>
<div class="field"><label>Eyebrow</label><input type="text" name="contactEyebrow" value="<%= d.settings.contactEyebrow %>"></div>
<div class="field"><label>Title</label><input type="text" name="contactTitle" value="<%= d.settings.contactTitle %>"></div>
<div class="field"><label>Subtitle</label><textarea name="contactSubtitle"><%= d.settings.contactSubtitle %></textarea></div>
<div class="row2">
<div class="field"><label>Contact Email</label><input type="text" name="contactEmail" value="<%= d.settings.contactEmail %>"></div>
<div class="field"><label>Contact Phone</label><input type="text" name="contactPhone" value="<%= d.settings.contactPhone %>"></div>
</div>
<div class="field"><label>Contact Address</label><input type="text" name="contactAddress" value="<%= d.settings.contactAddress %>"></div>

<h3 style="margin-top:26px"><i class="fa-solid fa-share-nodes"></i> Social Links</h3>
<div class="row2">
<div class="field"><label>Facebook URL</label><input type="text" name="socialLinks.facebook" value="<%= d.settings.socialLinks.facebook %>"></div>
<div class="field"><label>Instagram URL</label><input type="text" name="socialLinks.instagram" value="<%= d.settings.socialLinks.instagram %>"></div>
</div>
<div class="row2">
<div class="field"><label>LinkedIn URL</label><input type="text" name="socialLinks.linkedin" value="<%= d.settings.socialLinks.linkedin %>"></div>
<div class="field"><label>YouTube URL</label><input type="text" name="socialLinks.youtube" value="<%= d.settings.socialLinks.youtube %>"></div>
</div>

<button type="submit" class="btn btn-primary" style="margin-top:8px"><i class="fa-solid fa-floppy-disk"></i> Save Settings</button>
</form>

</div></div>
</body></html>