<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Login - <%= 'PuraPaw' %></title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--green:#7B4B94;--forest:#4A2C5A;--mint:#F0E6F5;--cream:#FFFFFF;--ink:#3D2E4F;--line:#E8E0EE}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',system-ui,sans-serif;background:linear-gradient(135deg,#4A2C5A 0%,#7B4B94 55%,#9B6BB0 100%);min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{background:#fff;border-radius:22px;padding:42px 36px;box-shadow:0 40px 80px -30px rgba(0,0,0,.5);width:100%;max-width:400px}
.logo{display:flex;align-items:center;gap:10px;justify-content:center;font-family:'Poppins';font-weight:800;font-size:24px;color:var(--forest);margin-bottom:6px}
.logo .mark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(--green),#C4A6D5);display:grid;place-items:center;color:#fff;font-size:20px}
.sub{text-align:center;color:#777;font-size:14px;margin-bottom:28px}
.field{margin-bottom:18px}
.field label{display:block;font-family:'Poppins';font-weight:500;font-size:14px;margin-bottom:7px;color:var(--ink)}
.field input{width:100%;padding:13px 16px;border:1.5px solid var(--line);border-radius:12px;font-family:'Inter';font-size:15px;color:var(--ink)}
.field input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 4px rgba(123,75,148,.1)}
.btn{width:100%;padding:14px;border:none;border-radius:12px;background:var(--green);color:#fff;font-family:'Poppins';font-weight:600;font-size:15px;cursor:pointer;transition:.2s}
.btn:hover{background:var(--forest)}
.err{background:#fdeaea;color:#c0392b;padding:12px 16px;border-radius:10px;font-size:14px;margin-bottom:18px;text-align:center}
.hint{margin-top:20px;padding:14px;background:var(--mint);border-radius:10px;font-size:13px;color:var(--forest);text-align:center}
.back{display:block;text-align:center;margin-top:16px;color:var(--green);font-size:14px;font-family:'Poppins';font-weight:500}
</style>
</head>
<body>
<div class="login-card">
<div class="logo"><span class="mark"><i class="fa-solid fa-paw"></i></span>PuraPaw</div>
<div class="sub">Admin Panel</div>
<% if (error) { %><div class="err"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>
<form action="/admin/login" method="POST">
<div class="field"><label>Username</label><input type="text" name="username" placeholder="admin" required autofocus></div>
<div class="field"><label>Password</label><input type="password" name="password" placeholder="admin123" required></div>
<button type="submit" class="btn">Login <i class="fa-solid fa-arrow-right"></i></button>
</form>
<div class="hint">Default: <b>admin</b> / <b>admin123</b></div>
<a href="/" class="back"><i class="fa-solid fa-arrow-left"></i> Back to website</a>
</div>
</body>
</html>
