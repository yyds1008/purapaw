<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= d.settings.brandName %> - <%= d.settings.brandTagline %></title>
<link rel="icon" type="image/x-icon" href="/images/favicon.ico">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<header id="header">
<div class="wrap nav">
<a href="#" class="logo"><span class="mark"><i class="fa-solid fa-paw"></i></span><%= d.settings.brandName %></a>
<nav class="nav-links" id="navLinks">
<% (d.settings.navItems || []).forEach(function(n){ %>
<a href="<%= n.anchor %>"><%= n.label %></a>
<% }) %>
</nav>
<div class="nav-cta">
<% if (authed) { %>
<a href="/admin" class="btn btn-ghost"><i class="fa-solid fa-gauge"></i> Admin</a>
<% } else { %>
<a href="/admin/login" class="btn btn-ghost"><i class="fa-solid fa-lock"></i> Admin</a>
<% } %>
<a href="#contact" class="btn btn-primary">Get Quote</a>
<button class="hamburger" id="hamburger"><i class="fa-solid fa-bars"></i></button>
</div>
</div>
</header>

<section class="hero" id="hero">
<div class="hero-bg"></div>
<div class="hero-blob b1"></div>
<div class="hero-blob b2"></div>
<span class="float-paw p1"><i class="fa-solid fa-paw"></i></span>
<span class="float-paw p2"><i class="fa-solid fa-paw"></i></span>
<div class="wrap hero-grid">
<div class="hero-copy reveal">
<span class="eyebrow"><i class="fa-solid fa-leaf"></i> <%= d.settings.heroEyebrow %></span>
<h1><%= d.settings.heroTitle %></h1>
<p class="hero-lead"><%= d.settings.heroLead %></p>
<div class="hero-actions">
<a href="#products" class="btn btn-light"><%= d.settings.heroExploreBtn %></a>
<a href="#oem" class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.5)"><%= d.settings.heroOemBtn %></a>
</div>
</div>
<div class="hero-visual reveal">
<div class="hero-card">
<span class="tag"><i class="fa-solid fa-leaf"></i> <%= d.settings.heroPlantBasedTag %></span>
<img src="<%= d.settings.heroImg %>" alt="cat litter">
</div>
<div class="hero-badge">
<div class="ico"><i class="fa-solid fa-flask"></i></div>
<div><b><%= d.settings.heroBadgeTitle %></b><span><%= d.settings.heroBadgeSub %></span></div>
</div>
</div>
</div>
</section>

<div class="marquee">
<div class="marquee-track">
<% d.settings._marquee.forEach(function(m){ %><span><i class="fa-solid fa-leaf"></i> <%= m %></span><% }) %>
<% d.settings._marquee.forEach(function(m){ %><span><i class="fa-solid fa-leaf"></i> <%= m %></span><% }) %>
</div>
</div>

<section class="section" id="products">
<div class="wrap">
<div class="section-head reveal">
<span class="eyebrow"><i class="fa-solid fa-box"></i> <%= d.settings.productsEyebrow %></span>
<h2><%= d.settings.productsTitle %></h2>
<p><%= d.settings.productsSubtitle %></p>
</div>
<div class="products-grid">
<% d.products.filter(function(p){return p.isActive;}).sort(function(a,b){return a.sortOrder-b.sortOrder;}).forEach(function(p){ %>
<div class="product-card reveal">
<div class="pimg">
<% if(p.badge){ %><span class="pill"><%= p.badge %></span><% } %>
<img src="<%= p.imageUrl %>" alt="<%= p.name %>">
</div>
<div class="pbody">
<h3><%= p.name %></h3>
<p style="font-size:14px;margin-bottom:14px"><%= p.description %></p>
<ul><% (p.features||[]).forEach(function(f){ %><li><%= f %></li><% }) %></ul>
<a href="#contact" class="product-link">Get a quote <i class="fa-solid fa-arrow-right"></i></a>
</div>
</div>
<% }) %>
</div>
</div>
</section>

<section class="section health" id="health">
<div class="wrap health-grid">
<div class="health-visual reveal">
<img src="https://images.pexels.com/photos/33585487/pexels-photo-33585487.jpeg?auto=compress&cs=tinysrgb&w=800" alt="health monitoring cat litter">
<div class="ring"><%= d.settings.healthRingText %></div>
</div>
<div class="health-copy reveal">
<span class="eyebrow"><i class="fa-solid fa-heart-pulse"></i> <%= d.settings.healthEyebrow %></span>
<h2><%= d.settings.healthTitle %></h2>
<p><%= d.settings.healthSubtitle %></p>
<div class="health-list">
<% d.healthItems.forEach(function(h){ %>
<div class="health-item">
<div class="hi-ico"><i class="fa-solid fa-<%= h.icon %>"></i></div>
<div><b><%= h.title %></b><br><span><%= h.description %></span></div>
</div>
<% }) %>
</div>
</div>
</div>
</section>

<section class="section about" id="about">
<div class="wrap about-grid">
<div class="about-imgs reveal">
<img class="main" src="<%= d.settings.aboutMainImg %>" alt="cat litter factory">
<img class="sub" src="<%= d.settings.aboutSubImg %>" alt="factory production line detail">
<div class="about-stats"><div class="n"><%= d.settings.aboutStat %></div><div class="t"><%= d.settings.aboutStatLbl %></div></div>
</div>
<div class="about-copy reveal">
<span class="eyebrow"><i class="fa-solid fa-leaf"></i> <%= d.settings.aboutEyebrow %></span>
<h2><%= d.settings.aboutTitle %></h2>
<p><%= d.settings.aboutText %></p>
<div class="why-grid">
<% d.whyPoints.forEach(function(w){ %>
<div class="why-card">
<div class="wi-ico"><i class="fa-solid fa-<%= w.icon %>"></i></div>
<div><h4><%= w.title %></h4><p><%= w.description %></p></div>
</div>
<% }) %>
</div>
</div>
</div>
</section>

<section class="section oem" id="oem">
<div class="wrap">
<div class="section-head reveal">
<span class="eyebrow"><i class="fa-solid fa-gears"></i> <%= d.settings.oemEyebrow %></span>
<h2><%= d.settings.oemTitle %></h2>
<p><%= d.settings.oemSubtitle %></p>
</div>
<div class="oem-grid">
<% d.services.forEach(function(s){ %>
<div class="oem-card reveal">
<div class="ico"><i class="fa-solid fa-<%= s.icon %>"></i></div>
<h3><%= s.title %></h3>
<p><%= s.description %></p>
</div>
<% }) %>
</div>
</div>
</section>

<section class="section process" id="process">
<div class="wrap">
<div class="section-head reveal">
<span class="eyebrow"><i class="fa-solid fa-route"></i> <%= d.settings.processEyebrow %></span>
<h2><%= d.settings.processTitle %></h2>
<p><%= d.settings.processSubtitle %></p>
</div>
<div class="process-grid">
<% d.processSteps.forEach(function(st){ %>
<div class="step reveal">
<div class="num"><%= st.step %></div>
<h4><%= st.title %></h4>
<p><%= st.description %></p>
</div>
<% }) %>
</div>
</div>
</section>

<section class="section feature" id="feature">
<div class="wrap feature-grid">
<div class="feature-visual reveal">
<img src="<%= d.settings.featureImg %>" alt="<%= d.settings.featureLabel %> detail">
<div class="price-tag"><i class="fa-solid fa-award"></i><div><b><%= d.settings.featureLabel %></b><span><%= d.settings.featureTag %></span></div></div>
</div>
<div class="feature-copy reveal">
<span class="eyebrow"><i class="fa-solid fa-star"></i> <%= d.settings.featureEyebrow %></span>
<h2><%= d.settings.featureTitle %></h2>
<p><%= d.settings.featureSubtitle %></p>
<div class="feat-list">
<% d.highlights.forEach(function(h){ %>
<div class="feat-item">
<div class="fi-ico"><i class="fa-solid fa-<%= h.icon %>"></i></div>
<div><b><%= h.title %></b><span><%= h.description %></span></div>
</div>
<% }) %>
</div>
</div>
</div>
</section>

<section class="section testi" id="testi">
<div class="wrap">
<div class="section-head reveal">
<span class="eyebrow"><i class="fa-solid fa-quote-left"></i> <%= d.settings.testiEyebrow %></span>
<h2><%= d.settings.testiTitle %></h2>
</div>
<div class="testi-grid">
<% d.testimonials.forEach(function(t){ %>
<div class="testi-card reveal">
<div class="quote">"</div>
<div class="stars"><% for(var i=0;i<(t.rating||5);i++){ %><i class="fa-solid fa-star"></i><% } %></div>
<p><%= t.content %></p>
<div class="testi-person">
<img class="av" src="<%= t.avatarUrl %>" alt="<%= t.author %>">
<div><b><%= t.author %></b><br><span><%= t.role %> · <%= t.company %></span></div>
</div>
</div>
<% }) %>
</div>
</div>
</section>

<section class="section blog" id="blog">
<div class="wrap">
<div class="section-head reveal">
<span class="eyebrow"><i class="fa-solid fa-newspaper"></i> <%= d.settings.blogEyebrow %></span>
<h2><%= d.settings.blogTitle %></h2>
</div>
<div class="blog-grid">
<% d.blogPosts.forEach(function(b){ %>
<div class="blog-card reveal">
<div class="bimg"><img src="<%= b.imageUrl %>" alt="<%= b.title %>"></div>
<div class="bbody">
<div class="meta"><i class="fa-solid fa-tag"></i> <%= b.category %> <span>·</span> <i class="fa-regular fa-calendar"></i> <%= b.publishDate %></div>
<h3><%= b.title %></h3>
<p><%= b.excerpt %></p>
<a href="#contact" class="rmore">Read more <i class="fa-solid fa-arrow-right"></i></a>
</div>
</div>
<% }) %>
</div>
</div>
</section>

<section class="cta">
<div class="wrap">
<div class="cta-box reveal">
<h2><%= d.settings.ctaTitle %></h2>
<p><%= d.settings.ctaSubtitle %></p>
<div class="cta-actions">
<a href="#contact" class="btn btn-primary"><%= d.settings.ctaPrimaryBtn %></a>
<a href="mailto:<%= d.settings.contactEmail %>" class="btn btn-light"><%= d.settings.ctaSecondaryBtn %></a>
</div>
</div>
</div>
</section>

<section class="section contact" id="contact">
<div class="wrap contact-grid">
<div class="contact-info reveal">
<span class="eyebrow"><i class="fa-solid fa-envelope"></i> <%= d.settings.contactEyebrow %></span>
<h2><%= d.settings.contactTitle %></h2>
<p><%= d.settings.contactSubtitle %></p>
<div class="ci-item"><div class="ico"><i class="fa-solid fa-envelope"></i></div><div><b>Email</b><br><span><%= d.settings.contactEmail %></span></div></div>
<div class="ci-item"><div class="ico"><i class="fa-solid fa-phone"></i></div><div><b>Phone / WhatsApp</b><br><span><%= d.settings.contactPhone %></span></div></div>
<div class="ci-item"><div class="ico"><i class="fa-solid fa-location-dot"></i></div><div><b>Address</b><br><span><%= d.settings.contactAddress %></span></div></div>
</div>
<form class="form reveal" action="/submit-inquiry" method="POST">
<% if (flash) { %>
<div style="background:#EEF2F7;color:#1B3A5C;padding:14px 18px;border-radius:12px;margin-bottom:16px;font-weight:600"><i class="fa-solid fa-circle-check"></i> <%= flash %></div>
<% } %>
<div class="form-row">
<div class="field"><label>Your Name</label><input type="text" name="name" required></div>
<div class="field"><label>Email</label><input type="email" name="email" required></div>
</div>
<div class="form-row">
<div class="field"><label>Product</label><input type="text" name="product" placeholder="Tofu / Corn / Cassava / Bamboo"></div>
<div class="field"><label>Tonnage / year</label><input type="text" name="tonnage" placeholder="e.g. 500 tons"></div>
</div>
<div class="field"><label>Message</label><textarea name="message" placeholder="Tell us your market, needs, timeline..."></textarea></div>
<button type="submit" class="btn btn-primary">Send Inquiry <i class="fa-solid fa-paper-plane"></i></button>
</form>
</div>
</section>

<footer>
<div class="wrap">
<div class="foot-grid">
<div class="foot-brand">
<div class="logo"><span class="mark"><i class="fa-solid fa-paw"></i></span><%= d.settings.brandName %></div>
<p><%= d.settings.footerAbout %></p>
<div class="foot-social">
<a href="<%= d.settings.socialLinks.facebook %>"><i class="fa-brands fa-facebook-f"></i></a>
<a href="<%= d.settings.socialLinks.instagram %>"><i class="fa-brands fa-instagram"></i></a>
<a href="<%= d.settings.socialLinks.linkedin %>"><i class="fa-brands fa-linkedin-in"></i></a>
<a href="<%= d.settings.socialLinks.youtube %>"><i class="fa-brands fa-youtube"></i></a>
</div>
</div>
<div class="foot-col"><h5>Products</h5><ul><% (d.settings.footerNav || d.products).forEach(function(p){ %><li><a href="<%= p.anchor || '#products' %>"><%= p.label || p.name %></a></li><% }) %></ul></div>
<div class="foot-col"><h5>Company</h5><ul><li><a href="#about">About</a></li><li><a href="#oem">OEM Service</a></li><li><a href="#process">Process</a></li><li><a href="#blog">Blog</a></li></ul></div>
<div class="foot-col"><h5>Resources</h5><ul><li><a href="#health">Health Litter</a></li><li><a href="#contact">Get Quote</a></li><li><a href="/admin/login">Admin Login</a></li></ul></div>
</div>
<div class="foot-bottom"><span>© <%= d.settings.copyrightYear %> <%= d.settings.brandName %>. All rights reserved.</span><a href="#hero"><%= d.settings.footerBackTop %></a></div>
</div>
</footer>

<button class="to-top" id="toTop"><i class="fa-solid fa-arrow-up"></i></button>
<script src="/js/site.js"></script>
</body>
</html>